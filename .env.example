# यह सिर्फ़ नमूना है। असली पासवर्ड और Keys इस फ़ाइल में कभी न लिखें।
# असली मान GitHub Secrets या सर्वर के Secrets Manager में रखे जाएँगे।

POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=platform_dev

REDIS_PASSWORD=change-me-use-a-long-random-password

# Login के Secrets: हर एक कम से कम 32 अक्षर, रैंडम, और आपस में अलग-अलग
JWT_SECRET=change-me-at-least-32-random-characters-long
OTP_PEPPER=change-me-at-least-32-random-characters-too

# Google Login: आपके OAuth Client ID (गुप्त नहीं है), कॉमा से अलग।
# यहाँ Client SECRET कभी न लिखें, उसकी ज़रूरत ही नहीं है।
GOOGLE_CLIENT_IDS=

# पहला Admin: अपना Google ईमेल या देश-कोड वाला फ़ोन नंबर (एक या दोनों)।
# उस पहचान से Login होने पर, और सिर्फ़ तब जब कोई Admin न हो, वह Admin बनता है।
# पहला Admin बनते ही इन सेटिंग्स को सर्वर से हटा दें।
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=

# नए ग्राहकों की सीमाएँ (सब वैकल्पिक; ख़ाली या ग़लत हो तो नीचे के डिफ़ॉल्ट)
ORDER_NEW_CUSTOMER_ORDERS=3
ORDER_MAX_OPEN_NEW=1
ORDER_MAX_OPEN_ESTABLISHED=3
# नए ग्राहक के Order की ऊपरी रक़म, पैसे में (50000 = Rs 500)
ORDER_NEW_CUSTOMER_COD_CAP_PAISE=50000

# डिलीवरी शुल्क, पैसे में (2000 = Rs 20), और "इतनी रक़म या ऊपर पर मुफ़्त" (0 = बंद)
DELIVERY_FEE_PAISE=2000
FREE_DELIVERY_ABOVE_PAISE=0

# संदेश-व्यवस्था: कितने मिलीसेकंड में कतार जाँचे (0 = बंद)
EVENTS_POLL_MS=2000

# सिर्फ़ विकास के लिए: true करने पर OTP लॉग में दिखेगा। Production में कभी नहीं।
OTP_DEV_LOG=false
