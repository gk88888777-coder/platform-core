# यह सिर्फ़ नमूना है। असली पासवर्ड और Keys इस फ़ाइल में कभी न लिखें।
# असली मान GitHub Secrets या सर्वर के Secrets Manager में रखे जाएँगे।

POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=platform_dev

REDIS_PASSWORD=change-me-use-a-long-random-password

# Login के Secrets: हर एक कम से कम 32 अक्षर, रैंडम, और आपस में अलग-अलग
JWT_SECRET=change-me-at-least-32-random-characters-long
OTP_PEPPER=change-me-at-least-32-random-characters-too

# पहला Admin: देश-कोड के साथ फ़ोन नंबर, जैसे +91xxxxxxxxxx।
# उस नंबर से OTP Login होने पर, और सिर्फ़ तब जब कोई Admin न हो, वह Admin बनता है।
# पहला Admin बनते ही इस सेटिंग को सर्वर से हटा दें।
BOOTSTRAP_ADMIN_PHONE=

# सिर्फ़ विकास के लिए: true करने पर OTP लॉग में दिखेगा। Production में कभी नहीं।
OTP_DEV_LOG=false
